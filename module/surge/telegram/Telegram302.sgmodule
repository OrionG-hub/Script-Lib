#!name=Telegram302
#!desc=将 Telegram 链接重定向到指定客户端，默认 Regram。可选：Telegram、Regram、Nagram、Swiftgram、Turrit、iMe、Nicegram、Lingogram。
#!author=pandaX
#!arguments=CLIENT:Regram
#!arguments-desc=默认 Regram，无需填写；切换时填写上述客户端名称。Telegram 保持原链接，不进行重定向。需启用 MITM 并信任证书。
[Script]
Telegram 链接重定向 = type=http-request, pattern=^https?://(?:t\.me|telegram\.me)/.+, script-path=https://raw.orionc.me/proxy/module/surge/js/Telegram302.js?token=orion-raw-19990126, timeout=10, argument="{{{CLIENT}}}"
[MITM]
hostname = %APPEND% t.me, telegram.me